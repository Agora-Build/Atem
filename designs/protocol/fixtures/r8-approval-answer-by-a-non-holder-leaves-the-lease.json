{
 "name": "r8-approval-answer-by-a-non-holder-leaves-the-lease",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   },
   {
    "name": "c3",
    "attachment_gen": "77777777-7777-4777-8777-777777777777",
    "permissions": [
     "view"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000002"
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000002",
    "sessions.#": 1
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "a1": "approval_id"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     }
    ],
    "approval_id": "${a1}"
   }
  },
  {
   "send": "c3",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "77777777-7777-4777-8777-777777777777"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "approval",
     "payload": {
      "approval_id": "${a1}",
      "decision": "allow_once"
     }
    }
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000003",
    "code": "forbidden"
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000002",
     "kind": "approval",
     "payload": {
      "approval_id": "${a1}",
      "decision": "allow_always",
      "rule_id": "r-npm-test"
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000004",
    "kind": "approval"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "approval_closed",
    "approval_id": "${a1}",
    "reason": "answered_remote"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_closed",
    "approval_id": "${a1}",
    "reason": "answered_remote"
   }
  },
  {
   "approval_applied": "${a1}",
   "ok": true
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "completed"
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "cargo check",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "cargo check",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "a2": "approval_id"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "cargo check",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     }
    ],
    "approval_id": "${a2}"
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000005",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666",
      "lease_epoch": 7
     },
     "request_id": "44444444-4444-4444-8444-000000000003",
     "kind": "approval",
     "payload": {
      "approval_id": "${a2}",
      "decision": "deny",
      "message": "not now"
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000003",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000005",
    "kind": "approval"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000003",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "approval_closed",
    "approval_id": "${a2}",
    "reason": "answered_remote"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_closed",
    "approval_id": "${a2}",
    "reason": "answered_remote"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "expect_none": "c3",
   "for_ms": 0
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "renew",
     "id": "11111111-1111-4111-8111-000000000006",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease",
    "re": "11111111-1111-4111-8111-000000000006",
    "binding.lease_epoch": 1
   }
  },
  {
   "assert": {
    "lease_holder": "c1",
    "approval_decisions": [
     {
      "approval_id": "${a1}",
      "decision": "allow_always",
      "rule_id": "r-npm-test"
     },
     {
      "approval_id": "${a2}",
      "decision": "deny",
      "message": "not now"
     }
    ]
   }
  }
 ],
 "note": "r8 approval answers need only a verified attachment with control and the exact pending request. c2 does not hold the lease and answers without lease_epoch, then with an epoch it does not hold (ignored, never checked): both are accepted and handed over; the lease never moves (no lease_changed, no session_changed) and c1 renews at the same epoch. A view-only attachment gets no card and its answer is forbidden."
}

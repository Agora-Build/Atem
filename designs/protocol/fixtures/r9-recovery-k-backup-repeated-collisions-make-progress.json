{
  "name": "r9-recovery-k-backup-repeated-collisions-make-progress",
  "requires": "r9",
  "kind": "scenario",
  "side": "client",
  "log": "r9-vectors-membership-log",
  "note": "R9.5 \"Writing a backup\" (Astation r4 review 3): other writers keep occupying versions while phone uploads: 409 {max_occupied: 4}, then 409 {max_occupied: 6}. Each 409 moves the next allocation strictly above the reported version (4, 5, 7), so phone commits version 7 after two collisions. A later 409 reporting a max_occupied more than 1024 above the newest committed version is relay misbehaviour: the writer stops and reports it instead of jumping.",
  "setup": {
    "account_id": "acct-test-1",
    "genesis_hash": "${hash:E1}",
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ],
    "client_log": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6",
      "KB7"
    ],
    "relay_occupied": [
      3,
      4
    ]
  },
  "steps": [
    {
      "client_backup": {
        "by": "phone",
        "kids": [
          "7a3c9e10",
          "b982533d",
          "1f2e3d4c"
        ],
        "kit": "recovery"
      }
    },
    {
      "expect_backup_put": {
        "by": "phone",
        "blob_version": 4
      },
      "name": "p4"
    },
    {
      "relay_reply": {
        "by": "phone",
        "status": 409,
        "max_occupied": 4
      }
    },
    {
      "expect_backup_put": {
        "by": "phone",
        "blob_version": 5
      },
      "name": "p5"
    },
    {
      "relay_reply": {
        "by": "phone",
        "status": 409,
        "max_occupied": 6
      }
    },
    {
      "expect_backup_put": {
        "by": "phone",
        "blob_version": 7
      },
      "name": "p7"
    },
    {
      "relay_reply": {
        "by": "phone",
        "status": 200
      }
    },
    {
      "expect_log_append": {
        "by": "phone",
        "action": "k_backup",
        "blob_version": 7,
        "seq": 8,
        "expected": "KB7",
        "backup_hash_of": "p7"
      }
    },
    {
      "relay_reply": {
        "by": "phone",
        "status": 200
      }
    },
    {
      "assert_client": {
        "by": "phone",
        "k_backup_committed": 7,
        "discarded": [
          "p4",
          "p5"
        ]
      }
    },
    {
      "client_backup": {
        "by": "phone",
        "kids": [
          "7a3c9e10",
          "b982533d"
        ],
        "kit": "recovery"
      }
    },
    {
      "expect_backup_put": {
        "by": "phone",
        "blob_version": 8
      },
      "name": "p8"
    },
    {
      "relay_reply": {
        "by": "phone",
        "status": 409,
        "max_occupied": 1032
      }
    },
    {
      "expect_backup_put_none": {
        "by": "phone"
      }
    },
    {
      "assert_client": {
        "by": "phone",
        "backup_error": "relay_misbehaviour",
        "k_backup_committed": 7
      }
    }
  ]
}

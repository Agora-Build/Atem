{
  "name": "r9-delegated-request-id-across-submitters",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "session-v1 R9.14 item 7. A `request_id` recorded under another submitter is `request_id_reused` when either submitter is the host-work principal, even with every immutable value equal. A native's id submitted by host-work is refused, and host-work's id submitted by a native is refused. Neither runs again.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      }
    ],
    "connected": [
      "mac"
    ]
  },
  "steps": [
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000601",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "cccccccc-0000-4000-8000-000000000601",
          "payload": {
            "text": "run the tests"
          },
          "acquire": true
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipt",
        "state": "accepted",
        "request_id": "cccccccc-0000-4000-8000-000000000601"
      }
    },
    {
      "turn_complete": "ses-aaaaaaaaaaaa",
      "turn_id": "turn-1"
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipt",
        "state": "completed",
        "request_id": "cccccccc-0000-4000-8000-000000000601"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "release",
          "id": "aaaaaaaa-0000-4000-8000-000000000602",
          "binding": "${lease_binding:mac:ses-aaaaaaaaaaaa}"
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "lease_released"
      }
    },
    {
      "host_work_submit": "ses-aaaaaaaaaaaa",
      "request_id": "cccccccc-0000-4000-8000-000000000601",
      "task_id": "dddddddd-0000-4000-8000-000000000601",
      "sender": "member:dev-phone",
      "text": "run the tests",
      "result": {
        "code": "request_id_reused"
      }
    },
    {
      "host_work_submit": "ses-aaaaaaaaaaaa",
      "request_id": "cccccccc-0000-4000-8000-000000000602",
      "task_id": "dddddddd-0000-4000-8000-000000000602",
      "sender": "member:dev-phone",
      "text": "run the tests",
      "result": {
        "state": "executing"
      }
    },
    {
      "turn_complete": "ses-aaaaaaaaaaaa",
      "turn_id": "turn-2"
    },
    {
      "expect": "mac",
      "match": {
        "op": "lease_changed",
        "reason": "released"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000603",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "cccccccc-0000-4000-8000-000000000602",
          "payload": {
            "text": "run the tests"
          },
          "acquire": true
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "error",
        "code": "request_id_reused"
      }
    },
    {
      "assert": {
        "receipts": {
          "cccccccc-0000-4000-8000-000000000601": {
            "state": "completed",
            "detail": "done"
          },
          "cccccccc-0000-4000-8000-000000000602": {
            "state": "completed",
            "detail": "done"
          }
        }
      }
    },
    {
      "assert": {
        "dispatches": 2
      }
    }
  ]
}

  {
   "assert": {
    "journal_halted": true,
    "lease_holder": null,
    "dispatch_attempts": 1
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "77777777-7777-4777-8777-777777777777"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000002"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000003",
    "code": "busy",
    "detail": "journal halted; restart Atem"
   }
  },
  {
   "restart_runtime": {
    "runtime_gen": "99999999-9999-4999-8999-999999999999",
    "runtime_epoch": 8
   }
  },
  {
   "reconnect": "c1",
   "attachment_gen": "88888888-8888-4888-8888-888888888888"
  },
  {
   "reconnect": "c2",
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "88888888-8888-4888-8888-888888888888"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000002"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000004",
    "receipts.#": 1,
    "receipts.0.state": "rejected",
    "receipts.0.detail": "authorization history unknown"
   }
  },
  {
   "set_permissions": "c1",
   "permissions": [
    "view",
    "control"
   ],
   "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000005",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000002"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000005",
    "receipts.#": 1,
    "receipts.0.state": "rejected",
    "receipts.0.detail": "authorization history unknown"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "dispatch_attempts": 1,
    "lease_holder": null
   }
  }
 ],
 "note": "Appendix §H. c1 loses control while P2 is queued. The fence (the first journal write of the revocation) is durable; the write rejecting P2 (the second) fails, so P2 is rejected in memory (\"A failed revocation write\"), the journal halts with P2 still accepted on disk, nothing queued is dispatched and every later request is busy. A halted run writes no clean close, so after the restart P2 is durably rejected at recovery before anything is dispatched, with the detail authorization history unknown (Recovery rule 2 applies whatever the journal holds, the durable fence included), whether or not c1 has reconnected; regaining control doesn't revive it."
}

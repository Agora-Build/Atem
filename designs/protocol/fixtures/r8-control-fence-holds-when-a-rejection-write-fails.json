    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000002"
   }
  },
  {
   "fail_fsync_of": 2
  },
  {
   "set_permissions": "c1",
   "permissions": [
    "view"
   ],
   "attachment_gen": "77777777-7777-4777-8777-777777777777"
  },

{
 "name": "r8-double-write-failure-takeover-never-runs",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1,
    "sessions.0.controller.lease_epoch": 1
   },
   "capture": {
    "c1ctl": "sessions.0.controller.controller_session"
   }
  },
  {
   "fail_next_fsync": true,
   "undo_fails": true
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000002",
    "code": "busy",
    "detail": "acceptance not recorded"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "lease_holder": "c1",
    "dispatch_attempts": 0,
    "journal_halted": true
   }
  },
  {
   "restart_runtime": {
    "runtime_gen": "99999999-9999-4999-8999-999999999999",
    "runtime_epoch": 8
   }
  },
  {
   "reconnect": "c1",
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "reconnect": "c2",
   "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 0
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "rejected",
    "re": "11111111-1111-4111-8111-000000000003",
    "detail": "acceptance not confirmed"
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000001"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000004",
    "receipts.#": 1,
    "receipts.0.state": "rejected",
    "receipts.0.detail": "acceptance not confirmed"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 0,
    "pty_writes": 0
   }
  }
 ],
 "note": "Appendix §I. c2 confirms a takeover of c1's lease and sends; the accepted write fails and so does its rollback, so the record may be on disk. The reply is busy (the refusal is on the refusal list), c1 keeps the lease and hears nothing, and nothing runs. At the restart (leases aren't persisted) the request is resolved rejected (acceptance not confirmed) before recovery dispatches anything, even if its accepted record is there: it was refused, so it never executes and never takes over. The same request_id with the same takeover flags returns the rejected receipt; c1 sees the same receipt."
}

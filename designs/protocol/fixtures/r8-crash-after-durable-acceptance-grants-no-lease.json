{
 "name": "r8-crash-after-durable-acceptance-grants-no-lease",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1,
    "sessions.0.controller.lease_epoch": 1
   },
   "capture": {
    "c1ctl": "sessions.0.controller.controller_session"
   }
  },
  {
   "crash_after_accepted": {
    "runtime_gen": "99999999-9999-4999-8999-999999999999",
    "runtime_epoch": 8
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "reconnect": "c1",
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 0
   }
  },
  {
   "reconnect": "c2",
   "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 1,
    "dispatches": 1
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000001"
     ]
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000003",
    "receipts.#": 1,
    "receipts.0.state": "executing"
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing",
    "re": "11111111-1111-4111-8111-000000000004"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 1
   }
  }
 ],
 "note": "Appendix §I.4 and §H. The accepted record of c2's confirmed takeover Send becomes durable, then the runtime crashes before the lease moves or the reply is sent (no reply, no lease_changed to c1). After the restart nobody holds the lease (leases aren't persisted) and the request is accepted: it waits until its principal (c2) is confirmed in this run; c1 reconnecting doesn't dispatch it, c2 reconnecting with control does, once. c2 queries first (uncertain delivery), then a resend with the same id and flags returns the recorded receipt and neither acquires nor takes over."
}

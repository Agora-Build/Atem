{
  "name": "r9-chain-lost-intent-restart-replays-and-stays-held",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.3 (Astation r4 review 2): the carriage record of a valid removal (E7, svc) is durable, then the intent write fails and is lost entirely. Atem fences svc in memory and halts. At restart nothing re-carries E7: the carriage record is replayed, so E7 is committed and svc fenced again, and the host is held (no checkpoint): it admits nobody on its own, not after a day and another orderly restart. A managing device reporting E7 reconciles it; svc stays removed.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ],
    "connected": [
      "phone"
    ],
    "holds_lease": {
      "svc": 1
    }
  },
  "steps": [
    {
      "fail_next_membership_write": {
        "at": "intent"
      }
    },
    {
      "send_membership": "phone",
      "entries": [
        "E7"
      ]
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "removed"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "lease_changed",
        "reason": "revoked"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "error",
        "code": "busy",
        "detail": "device list not recorded"
      }
    },
    {
      "assert": {
        "head": "E6",
        "membership_halted": true,
        "carriage_record": true
      }
    },
    {
      "local_input": "ses-aaaaaaaaaaaa",
      "bytes": "bHMNCg=="
    },
    {
      "assert": {
        "pty_writes_local": 1,
        "pty_writes_remote": 0
      }
    },
    {
      "restart_runtime": {
        "runtime_gen": "44444444-4444-4444-8444-444444444444",
        "runtime_epoch": 2
      },
      "disk": "write_lost"
    },
    {
      "assert": {
        "head": "E7",
        "membership_applied": "E7",
        "membership_held": true,
        "membership_unclean": null,
        "carriage_record": false,
        "control_gen": {
          "service:svc-discord": 2
        }
      }
    },
    {
      "connect": "svc",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "busy",
        "detail": "device list not reconciled"
      }
    },
    {
      "advance_ms": 86400000
    },
    {
      "restart_runtime": {
        "runtime_gen": "55555555-5555-4555-8555-555555555555",
        "runtime_epoch": 3
      }
    },
    {
      "assert": {
        "membership_held": true
      }
    },
    {
      "connect": "svc",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "busy",
        "detail": "device list not reconciled"
      }
    },
    {
      "connect": "mac",
      "carry": [],
      "client_head": "E7"
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "principal": "member:dev-mac",
        "head.seq": 7,
        "head.hash": "${hash:E7}"
      }
    },
    {
      "assert": {
        "membership_held": false
      }
    },
    {
      "connect": "svc",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "removed"
      }
    }
  ]
}

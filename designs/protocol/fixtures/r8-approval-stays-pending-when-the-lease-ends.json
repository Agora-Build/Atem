{
 "name": "r8-approval-stays-pending-when-the-lease-ends",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "a1": "approval_id"
   }
  },
  {
   "advance_ms": 15000
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "expired",
    "lease_epoch": 2,
    "controller": null
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "session_changed",
    "descriptor.controller": null
   }
  },
  {
   "assert": {
    "approvals_pending": 1,
    "approvals_released": 0,
    "lease_holder": null,
    "pushes": [
     {
      "op": "push_approval",
      "approval_id": "${a1}"
     }
    ]
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "approval",
     "payload": {
      "approval_id": "${a1}",
      "decision": "allow_once"
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000002",
    "kind": "approval"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_closed",
    "approval_id": "${a1}",
    "reason": "answered_remote"
   }
  },
  {
   "assert": {
    "approval_decisions": [
     {
      "approval_id": "${a1}",
      "decision": "allow_once"
     }
    ],
    "approvals_pending": 0,
    "lease_holder": null,
    "pushes": [
     {
      "op": "push_approval",
      "approval_id": "${a1}"
     },
     {
      "op": "push_resolved",
      "approval_id": "${a1}",
      "reason": "answered_remote"
     }
    ]
   }
  },
  {
   "approval_applied": "${a1}",
   "ok": true
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "completed"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  }
 ]
}

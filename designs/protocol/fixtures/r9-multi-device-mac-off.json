{
  "name": "r9-multi-device-mac-off",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.10: with no Mac connected and the cred agent locked, the phone reaches the host through the relay channel on its own (host key, head and fences need neither); push hints are sealed to every control member, the Mac included.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000,
      "cred_agent": "locked",
      "astation_desktop_connected": false
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ]
  },
  "steps": [
    {
      "connect": "phone",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 6,
        "head.hash": "${hash:E6}"
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000050",
          "binding": "${binding:phone:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000050",
          "acquire": true,
          "payload": {
            "text": "run the tests"
          }
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "receipt",
        "state": "accepted",
        "lease.lease_epoch": 1
      }
    },
    {
      "open_approval": "ses-aaaaaaaaaaaa",
      "tool": "Bash",
      "summary": "npm test"
    },
    {
      "expect": "phone",
      "match": {
        "op": "approval_request"
      },
      "capture": {
        "ap": "approval_id"
      }
    },
    {
      "expect_relay": {
        "op": "push_hint",
        "hints.#": 2,
        "hints.0.body.recipient.device_id": "dev-mac",
        "hints.1.body.recipient.device_id": "dev-phone"
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000051",
          "binding": "${binding:phone:ses-aaaaaaaaaaaa}",
          "kind": "approval",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000051",
          "payload": {
            "approval_id": "${ap}",
            "decision": "allow_once"
          }
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "receipt",
        "state": "accepted"
      }
    },
    {
      "approval_applied": "${ap}",
      "ok": true
    },
    {
      "expect": "phone",
      "match": {
        "op": "receipt",
        "state": "completed"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "approval_closed",
        "reason": "answered_remote"
      }
    },
    {
      "expect_relay": {
        "op": "push_hint",
        "hints.0.body.state": "resolved"
      }
    },
    {
      "assert": {
        "lease_holder": "phone",
        "approval_decisions.#": 1
      }
    }
  ]
}

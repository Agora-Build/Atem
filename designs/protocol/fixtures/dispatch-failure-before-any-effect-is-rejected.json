{
 "name": "dispatch-failure-before-any-effect-is-rejected",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   }
  ]
 },
 "steps": [
  {
   "fail_next_pty_enqueue": true
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000001",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-444444444446",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     }
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-444444444446",
    "state": "accepted"
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-444444444446",
    "state": "executing"
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-444444444446",
    "state": "rejected",
    "detail": "could not write to the terminal"
   }
  },
  {
   "assert": {
    "dispatch_attempts": 1,
    "pty_bytes_written": 0
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-444444444446",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     }
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-444444444446",
    "state": "rejected"
   }
  },
  {
   "restart_runtime": {
    "runtime_gen": "99999999-9999-4999-8999-999999999999",
    "runtime_epoch": 8
   }
  },
  {
   "reconnect": "c1",
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
     },
     "request_ids": [
      "44444444-4444-4444-8444-444444444446"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "receipts",
    "receipts.0.request_id": "44444444-4444-4444-8444-444444444446",
    "receipts.0.state": "rejected"
   }
  },
  {
   "assert": {
    "dispatch_attempts": 1
   }
  }
 ],
 "note": "The final failure state is durable, never retried, returned for a duplicate submit and still reported after a runtime restart."
}
      "connect": "phone",
      "carry": [
        "R7"
      ]
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7}",
        "pending_recovery": [
          {
            "entry_hash": "${hash:R7}",
            "seq": 7,
            "action": "recovery_add",
            "subject": "dev-newmac",
            "effective_at": 1793264001000
          }
        ]
      }
    },
    {
      "expect_local_status": {
        "recovery_pending": true
      }
    },
    {
      "connect": "newmac",
      "carry": []
    },
    {
      "expect": "newmac",
      "match": {
        "op": "error",
        "code": "recovery_pending",
        "entry_hash": "${hash:R7}",
        "effective_at": 1793264001000
      }
    },
    {
      "connect": "phone",
      "carry": [
        "N8"
      ]
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7}",
        "pending_recovery": [
          {
            "entry_hash": "${hash:R7}",
            "seq": 7,
            "action": "recovery_add",
            "subject": "dev-newmac",
            "effective_at": 1793264001000
          }
        ]
      }
    },
    {
      "assert": {
        "head": "R7",
        "pending": {
          "R7": "pending"
        },
        "members": [
          "dev-mac",
          "dev-phone",
          "svc-discord"
        ]
      }
    },
    {
      "advance_ms": 86399000
    },
    {
      "connect": "newmac",
      "carry": []
    },
    {
      "expect": "newmac",
      "match": {
        "op": "error",
        "code": "recovery_pending",
        "entry_hash": "${hash:R7}",
        "effective_at": 1793264001000
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "assert": {
        "pending": {
          "R7": "active"
        },
        "members": [
          "dev-mac",
          "dev-newmac",
          "dev-phone",
          "svc-discord"
        ]
      }
    },
    {
      "expect_local_status": {
        "recovery_pending": false
      }
    },
    {
      "connect": "newmac",
      "carry": [
        "N8"
      ]
    },
    {
      "expect": "newmac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-newmac",
        "permissions": [
          "control",
          "view"

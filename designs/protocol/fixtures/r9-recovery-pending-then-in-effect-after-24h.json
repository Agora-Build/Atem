{
  "name": "r9-recovery-pending-then-in-effect-after-24h",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.5: a recovery_add is pending for 24 h from when this host first committed it (monotonic and wall, whichever ends later). Its subject gets no access meanwhile (recovery_pending); an entry it signed is deferred (the carriage stops before it without an error and the carrier is admitted). At 24 h it takes effect with no new entry, and the deferred entry then applies.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793177601000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "newmac",
        "principal": "member:dev-newmac",
        "key": "dev-newmac"
      }
    ]
  },
  "steps": [

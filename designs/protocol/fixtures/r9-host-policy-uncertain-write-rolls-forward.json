{
  "name": "r9-host-policy-uncertain-write-rolls-forward",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.8a: the policy file's rename happened but its directory fsync failed: uncertain, with the new value and state uncertain; the pending file stays (no local link) and a retry says uncertain too; the pass rolls it forward within 5 s, after which the retry is committed and durable. A restart finds it durable.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000,
      "link": "relay"
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      }
    ],
    "connected": []
  },
  "steps": [
    {
      "connect": "mac",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9
      },
      "capture": {
        "mac_channel": "channel_id",
        "mac_att": "attachment_gen"
      }
    },
    {
      "fail_next_membership_write": {
        "file": "host_policy",
        "at": "directory_fsync"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_set",
          "id": "aaaaaaaa-0000-4000-8000-000000000901",
          "request_id": "cccccccc-0000-4000-8000-000000000901",
          "relay_only": true,
          "expected_revision": 0
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "host_policy_result",
        "re": "aaaaaaaa-0000-4000-8000-000000000901",
        "outcome": "uncertain",
        "policy.relay_only": true,
        "policy.revision": 1,
        "policy.state": "uncertain",
        "channel_id": "${mac_channel}",
        "attachment_gen": "${mac_att}",
        "request_id": "cccccccc-0000-4000-8000-000000000901"
      }
    },
    {
      "assert": {
        "host_policy": {
          "relay_only": true,
          "revision": 1,
          "pending": true
        }
      }
    },
    {
      "advance_ms": 6000
    },
    {
      "assert": {
        "host_policy": {
          "relay_only": true,
          "revision": 1,
          "pending": false
        }
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_set",
          "id": "aaaaaaaa-0000-4000-8000-000000000902",
          "request_id": "cccccccc-0000-4000-8000-000000000901",
          "relay_only": true,
          "expected_revision": 0
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "host_policy_result",
        "re": "aaaaaaaa-0000-4000-8000-000000000902",
        "outcome": "committed",
        "policy.relay_only": true,
        "policy.revision": 1,
        "policy.state": "durable",
        "channel_id": "${mac_channel}",
        "attachment_gen": "${mac_att}",
        "request_id": "cccccccc-0000-4000-8000-000000000901"
      }
    },
    {
      "restart_runtime": {
        "runtime_gen": "44444444-4444-4444-8444-444444444444",
        "runtime_epoch": 2
      }
    },
    {
      "connect": "mac",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9
      },
      "capture": {
        "mac_channel": "channel_id",
        "mac_att": "attachment_gen"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_get",
          "id": "aaaaaaaa-0000-4000-8000-000000000903"
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "host_policy_result",
        "re": "aaaaaaaa-0000-4000-8000-000000000903",
        "outcome": "current",
        "policy.relay_only": true,
        "policy.revision": 1,
        "policy.state": "durable",
        "channel_id": "${mac_channel}",
        "attachment_gen": "${mac_att}"
      }
    }
  ]
}

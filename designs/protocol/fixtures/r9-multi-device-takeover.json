{
  "name": "r9-multi-device-takeover",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.10: a confirmed takeover (r8 §F) between two member principals; the old holder keeps control (no fence: its control_gen is unchanged) but its epoch is stale.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ],
    "connected": [
      "phone"
    ],
    "holds_lease": {
      "mac": 1
    }
  },
  "steps": [
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000060",
          "binding": "${binding:phone:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000060",
          "acquire": true,
          "payload": {
            "text": "continue"
          }
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "error",
        "code": "lease_held"
      },
      "capture": {
        "holder": "controller.controller_session"
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000061",
          "binding": "${binding:phone:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000060",
          "acquire": true,
          "takeover": true,
          "expected_controller": {
            "controller_session": "${holder}",
            "lease_epoch": 1
          },
          "payload": {
            "text": "continue"
          }
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "receipt",
        "state": "accepted",
        "lease.lease_epoch": 2
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "lease_changed",
        "reason": "takeover",
        "lease_epoch": 2
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "terminal",
        "data": {
          "v": 1,
          "op": "input",
          "terminal_id": "ses-aaaaaaaaaaaa",
          "generation": "22222222-2222-4222-8222-222222222222",
          "stream_id": "dddddddd-0000-4000-8000-000000000060",
          "sequence": 0,
          "bytes": "eA==",
          "binding": "${lease_binding:mac:ses-aaaaaaaaaaaa}"
        }
      }
    },
    {
      "expect": "mac",
      "type": "terminal",
      "match": {
        "op": "error",
        "code": "stale_lease"
      }
    },
    {
      "assert": {
        "lease_holder": "phone",
        "pty_writes_remote": 0,
        "control_gen": {
          "member:dev-mac": 1
        }
      }
    }
  ]
}

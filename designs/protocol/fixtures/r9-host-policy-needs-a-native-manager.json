{
  "name": "r9-host-policy-needs-a-native-manager",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.8a: only a native member holding manage at the head may set or read the policy; a service and a browser get forbidden for both, whatever their ops; nothing is stored.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000,
      "link": "relay"
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      },
      {
        "name": "browser",
        "principal": "browser:7b2d8c5a-0e3f-4a41-9c9d-3e4f5a6b7c8d",
        "key": "browser",
        "grant": "r9-vectors-browser-grant:grant"
      }
    ],
    "connected": []
  },
  "steps": [
    {
      "connect": "svc",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "welcome",
        "revision": 9
      },
      "capture": {
        "svc_channel": "channel_id",
        "svc_att": "attachment_gen"
      }
    },
    {
      "connect": "browser",
      "carry": [],
      "grant": "${vector:r9-vectors-browser-grant:grant}"
    },
    {
      "expect": "browser",
      "match": {
        "op": "welcome",
        "revision": 9
      },
      "capture": {
        "browser_channel": "channel_id",
        "browser_att": "attachment_gen"
      }
    },
    {
      "send": "svc",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_set",
          "id": "aaaaaaaa-0000-4000-8000-000000000901",
          "request_id": "cccccccc-0000-4000-8000-000000000901",
          "relay_only": true,
          "expected_revision": 0
        }
      }
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "re": "aaaaaaaa-0000-4000-8000-000000000901",
        "code": "forbidden"
      }
    },
    {
      "send": "svc",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_get",
          "id": "aaaaaaaa-0000-4000-8000-000000000902"
        }
      }
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "re": "aaaaaaaa-0000-4000-8000-000000000902",
        "code": "forbidden"
      }
    },
    {
      "send": "browser",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_set",
          "id": "aaaaaaaa-0000-4000-8000-000000000903",
          "request_id": "cccccccc-0000-4000-8000-000000000903",
          "relay_only": true,
          "expected_revision": 0
        }
      }
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "re": "aaaaaaaa-0000-4000-8000-000000000903",
        "code": "forbidden"
      }
    },
    {
      "send": "browser",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "host_policy_get",
          "id": "aaaaaaaa-0000-4000-8000-000000000904"
        }
      }
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "re": "aaaaaaaa-0000-4000-8000-000000000904",
        "code": "forbidden"
      }
    },
    {
      "assert": {
        "host_policy": {
          "relay_only": false,
          "revision": 0,
          "pending": false
        }
      }
    }
  ]
}

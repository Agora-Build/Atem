{
  "name": "r9-envelope-link-loss",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.7a: losing Atem's link closes every channel and fences their attachments (the lease ends by its expiry, never carried); the reconnect is a new link generation where an old handle is unknown, and a fresh handshake gets a new attachment with no lease.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ]
  },
  "steps": [
    {
      "link_up": true
    },
    {
      "connect": "phone",
      "channel": "ch-phone",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome"
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "acquire",
          "id": "aaaaaaaa-0000-4000-8000-000000000301",
          "binding": "${binding:phone:ses-aaaaaaaaaaaa}",
          "takeover": false
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "lease"
      }
    },
    {
      "link_down": true
    },
    {
      "assert": {
        "channels": 0,
        "attachments": 0
      }
    },
    {
      "link_up": true
    },
    {
      "envelope_in": {
        "type": "channel",
        "event": "frame",
        "channel": "ch-phone",
        "frame": {
          "ch": "atem-ch1",
          "op": "rec",
          "ct": "AAAAAAAAAAAAAAAAAAAAAA"
        }
      }
    },
    {
      "expect_envelope": {
        "match": {
          "event": "close",
          "channel": "ch-phone",
          "reason": "unknown_channel"
        }
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "connect": "phone",
      "channel": "ch-phone-2",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome"
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "list",
          "id": "aaaaaaaa-0000-4000-8000-000000000302"
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "sessions",
        "sessions.0.controller": null
      }
    }
  ]
}

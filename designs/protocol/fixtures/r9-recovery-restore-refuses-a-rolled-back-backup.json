        "relay_log": [
          "E1",
          "E2",
          "E3",
          "E4",
          "E5",
          "E6",
          "KB7"
        ],
        "relay_blob": "${vector:r9-vectors-recovery:k_backup.wire}",
        "host_heads": {
          "host-a": "KB8"
        }
      },
      "result": "refused",
      "detail": "log_behind_host",
      "published": false
    },
    {
      "restore": {
        "kit": "recovery",
        "relay_log": [

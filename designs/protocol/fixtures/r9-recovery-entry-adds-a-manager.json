{
  "name": "r9-recovery-entry-adds-a-manager",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.5: the recovery_add signed by the genesis recovery key chains from Atem's head and is applied like any entry; it adds a manager and removes nobody. Amended for the 24 h wait (R9.5): newmac carries R7 and is refused recovery_pending; the entry takes effect after 24 h on the host clock, with no new entry, and newmac is then welcomed as a manager.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793177601000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "newmac",
        "principal": "member:dev-newmac",
        "key": "dev-newmac"
      },
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      }
    ]
  },
  "steps": [
    {
      "connect": "newmac",
      "carry": [
        "R7"
      ]
    },
    {
      "expect": "newmac",
      "match": {
        "op": "error",
        "code": "recovery_pending",
        "entry_hash": "${hash:R7}",
        "effective_at": 1793264001000
      }
    },
    {
      "assert": {
        "head": "R7",
        "pending": {
          "R7": "pending"
        },
        "members": [
          "dev-mac",
          "dev-phone",
          "svc-discord"
        ]
      }
    },
    {
      "advance_ms": 86400000
    },
    {
      "assert": {
        "pending": {
          "R7": "active"
        }
      }
    },
    {
      "connect": "newmac",
      "carry": []
    },
    {
      "expect": "newmac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-newmac",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7}"
      }
    },
    {
      "connect": "mac",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-mac",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7}"
      }
    },
    {
      "assert": {
        "head": "R7",
        "frozen": false,
        "members": [
          "dev-mac",
          "dev-newmac",
          "dev-phone",
          "svc-discord"
        ]
      }
    }
  ]
}

{
 "name": "approval-needs-control-and-the-lease",
 "setup": {
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222"
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "holds_lease_epoch": 1,
    "client_kind": "native"
   },
   {
    "name": "v",
    "attachment_gen": "77777777-7777-4777-8777-777777777777",
    "permissions": [
     "view"
    ],
    "client_kind": "native"
   }
  ],
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  }
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "send": "v",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000002"
    }
   }
  },
  {
   "expect": "v",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000002",
    "sessions.#": 1
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    },
    {
     "rule_id": "r-npm",
     "label": "Bash(npm:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     },
     {
      "rule_id": "r-npm",
      "label": "Bash(npm:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "aid": "approval_id"
   }
  },
  {
   "send": "v",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "77777777-7777-4777-8777-777777777777",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "approval",
     "payload": {
      "approval_id": "${aid}",
      "decision": "allow_once"
     }
    }
   }
  },
  {
   "expect": "v",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000003",
    "code": "forbidden"
   }
  },
  {
   "assert": {
    "approval_decisions": [],
    "approvals_pending": 1,
    "dispatches": 0,
    "receipts_visible": {
     "c1": 0,
     "v": 0
    }
   }
  }
 ],
 "note": "Approvals go only to attachments with control: a view-only attachment that listed gets no approval_request, and answering needs control (forbidden) — nothing changes."
}

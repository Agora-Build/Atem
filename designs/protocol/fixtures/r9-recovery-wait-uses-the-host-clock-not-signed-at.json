{
  "name": "r9-recovery-wait-uses-the-host-clock-not-signed-at",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.5: R7_backdated claims signed_at three days before the host's clock; the wait still starts when the host first commits it. A forward wall-clock jump alone doesn't end the wait (the monotonic side hasn't elapsed), and a runtime restart keeps the pending entry and the time already waited.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793177601000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "newmac",
        "principal": "member:dev-newmac",
        "key": "dev-newmac"
      }
    ]
  },
  "steps": [
    {
      "connect": "phone",
      "carry": [
        "R7_backdated"
      ]
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7_backdated}",
        "pending_recovery": [
          {
            "entry_hash": "${hash:R7_backdated}",
            "seq": 7,
            "action": "recovery_add",
            "subject": "dev-newmac",
            "effective_at": 1793264001000
          }
        ]
      }
    },
    {
      "set_wall_clock": 1793264001001
    },
    {
      "connect": "newmac",
      "carry": []
    },
    {
      "expect": "newmac",
      "match": {
        "op": "error",
        "code": "recovery_pending",
        "entry_hash": "${hash:R7_backdated}"
      }
    },
    {
      "advance_ms": 43200000
    },
    {
      "restart_runtime": {
        "runtime_gen": "99999999-9999-4999-8999-999999999999",
        "runtime_epoch": 2
      }
    },
    {
      "assert": {
        "head": "R7_backdated",
        "pending": {
          "R7_backdated": "pending"
        }
      }
    },
    {
      "connect": "newmac",
      "carry": []
    },
    {
      "expect": "newmac",
      "match": {
        "op": "error",
        "code": "recovery_pending",
        "entry_hash": "${hash:R7_backdated}"
      }
    },
    {
      "advance_ms": 43200000
    },
    {
      "assert": {
        "pending": {
          "R7_backdated": "active"
        }
      }
    },
    {
      "connect": "newmac",
      "carry": []
    },
    {
      "expect": "newmac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-newmac",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7_backdated}",
        "pending_recovery": []
      }
    }
  ]
}

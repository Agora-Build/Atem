{
 "name": "r8-client-enables-only-advertised-features",
 "side": "client",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "hello",
     "id": "11111111-1111-4111-8111-000000000001",
     "revision": 8
    }
   }
  },
  {
   "deliver_to_client": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "welcome",
     "id": "11111111-1111-4111-8111-000000000002",
     "re": "11111111-1111-4111-8111-000000000900",
     "account_id": "account-a",
     "atem_device_id": "host-a",
     "host_trust_gen": 1,
     "runtime_gen": "55555555-5555-4555-8555-555555555555",
     "controller_session": "12121212-1212-4212-8212-121212121212",
     "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
     "client_kind": "native",
     "permissions": [
      "view",
      "control"
     ],
     "authorization_ms_left": 86400000,
     "server_time": 1760500000000,
     "revision": 8,
     "features": [
      "chat.history_end",
      "chat.history",
      "receipt.result",
      "approval.session_rules",
      "chat.future-thing"
     ]
    }
   }
  },
  {
   "assert_client": {
    "admitted": true,
    "revision": 8,
    "features_enabled": [
     "chat.history_end",
     "chat.history",
     "receipt.result",
     "approval.session_rules"
    ],
    "lookup_enabled": false,
    "coverage_enabled": false
   }
  },
  {
   "client_try": "c1",
   "json": {
    "type": "agentChat",
    "data": {
     "v": 1,
     "op": "history",
     "conversationId": "conv-1",
     "agentId": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "page_id": "p1",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "turn_id": "turn-1"
    }
   },
   "refused": "feature chat.lookup not advertised"
  },
  {
   "assert_client": {
    "sent": []
   }
  }
 ],
 "note": "Client side: welcome.revision is 8 but features lacks chat.lookup and chat.coverage. The client enables exactly the advertised features it knows (an unknown feature name is ignored), refuses locally to send a history lookup (turn_id or request_id) and sends nothing. A client that requires a missing feature for an operation shows that operation as unavailable; it never guesses the host supports it."
}
{
 "name": "approval-pending-is-sent-again-after-list",
 "setup": {
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222"
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "holds_lease_epoch": 1,
    "client_kind": "native"
   }
  ],
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  }
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    },
    {
     "rule_id": "r-npm",
     "label": "Bash(npm:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     },
     {
      "rule_id": "r-npm",
      "label": "Bash(npm:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "aid": "approval_id"
   }
  },
  {
   "reconnect": "c1",
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000002"
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000002",
    "seq": 1
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     },
     {
      "rule_id": "r-npm",
      "label": "Bash(npm:*)",
      "scope": "this project"
     }
    ],
    "approval_id": "${aid}"
   }
  },
  {
   "assert": {
    "approvals_pending": 1
   }
  },
  {
   "advance_ms": 15000
  },
  {
   "expect": "c1",
   "match": {
    "op": "lease_changed",
    "reason": "expired",
    "controller": null
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "session_changed",
    "seq": 2
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_closed",
    "approval_id": "${aid}",
    "reason": "lease_lost"
   }
  }
 ],
 "note": "Pending approvals follow every sessions snapshot: a reconnected attachment (new attachment_gen, no lease) sees nothing until it lists, then gets the snapshot and the pending approval; it then hears the approval close when the old attachment's lease expires."
}

{
  "name": "r9-browser-grant",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.6: a QR grant gives a view-only browser principal on its target session; revoke_grant fences it at once and refuses it afterwards; a grant longer than 1 h or issued by a service is refused. (Issuer removal fences its grants through §H like any revocation.)",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264001000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      },
      {
        "session_id": "ses-bbbbbbbbbbbb",
        "process_gen": "33333333-3333-4333-8333-333333333333",
        "chat": true,
        "project": "h1.b982533d.cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "browser",
        "principal": "browser:7b2d8c5a-0e3f-4a41-9c9d-3e4f5a6b7c8d",
        "key": "browser",
        "grant": "r9-vectors-browser-grant:grant"
      }
    ]
  },
  "steps": [
    {
      "connect": "browser",
      "grant": "${vector:r9-vectors-browser-grant:grant}",
      "carry": []
    },
    {
      "expect": "browser",
      "match": {
        "op": "welcome",
        "client_kind": "browser",
        "principal": "browser:7b2d8c5a-0e3f-4a41-9c9d-3e4f5a6b7c8d",
        "permissions": [
          "view"
        ],
        "authorization_ms_left": 3599000
      }
    },
    {
      "send": "browser",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "list",
          "id": "aaaaaaaa-0000-4000-8000-000000000020"
        }
      }
    },
    {
      "expect": "browser",
      "match": {
        "op": "sessions",
        "sessions.#": 1,
        "sessions.0.session_id": "ses-aaaaaaaaaaaa"
      }
    },
    {
      "send": "browser",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "acquire",
          "id": "aaaaaaaa-0000-4000-8000-000000000021",
          "binding": "${binding:browser:ses-aaaaaaaaaaaa}"
        }
      }
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "code": "forbidden"
      }
    },
    {
      "connect": "phone",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 6,
        "head.hash": "${hash:E6}"
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "revoke_grant",
          "id": "aaaaaaaa-0000-4000-8000-000000000022",
          "grant_id": "7b2d8c5a-0e3f-4a41-9c9d-3e4f5a6b7c8d"
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "grant_revoked",
        "re": "aaaaaaaa-0000-4000-8000-000000000022"
      }
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "grant revoked"
      }
    },
    {
      "connect": "browser",
      "grant": "${vector:r9-vectors-browser-grant:grant}",
      "carry": []
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "grant revoked"
      }
    },
    {
      "connect": "browser",
      "grant": "${vector:r9-vectors-browser-grant:invalid.0.grant}",
      "carry": []
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "invalid grant"
      }
    },
    {
      "connect": "browser",
      "grant": "${vector:r9-vectors-browser-grant:invalid.1.grant}",
      "carry": []
    },
    {
      "expect": "browser",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "invalid grant"
      }
    }
  ]
}

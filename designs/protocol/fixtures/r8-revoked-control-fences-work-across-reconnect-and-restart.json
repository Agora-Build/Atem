   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000001",
    "lease.lease_epoch": 1
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "granted",
    "lease_epoch": 1
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-000000000002",
     "kind": "prompt",
     "payload": {
      "text": "then deploy"
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000002"
   }
  },
  {
   "disconnect": "c1"
  },
  {
   "reconnect": "c1",
   "attachment_gen": "77777777-7777-4777-8777-777777777777"
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "turn_complete": "ses-aaaaaaaaaaaa",
   "turn_id": "turn-1"
  },
  {
   "assert": {
    "dispatch_attempts": 2,
    "dispatches": 2
   }
  },
  {
   "advance_ms": 15000
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "expired",
    "lease_epoch": 2,
    "controller": null
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "expired",
    "lease_epoch": 2,
    "controller": null
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "77777777-7777-4777-8777-777777777777"
     },
     "request_id": "44444444-4444-4444-8444-000000000003",
     "kind": "prompt",
     "payload": {
      "text": "then tag the release"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000003",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000003",
    "lease.lease_epoch": 3
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "granted",
    "lease_epoch": 3
   }
  },
  {
   "disconnect": "c1"
  },
  {
   "set_permissions": "c1",
   "permissions": [
    "view"
   ],
   "attachment_gen": "88888888-8888-4888-8888-888888888888"
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "revoked",
    "lease_epoch": 4,
    "controller": null
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "turn_complete": "ses-aaaaaaaaaaaa",
   "turn_id": "turn-2"
  },
  {
   "assert": {
    "dispatch_attempts": 2,
    "lease_holder": null
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "88888888-8888-4888-8888-888888888888"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000001",
      "44444444-4444-4444-8444-000000000002",
      "44444444-4444-4444-8444-000000000003"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000004",
    "receipts.#": 3,
    "receipts.0.state": "completed",
    "receipts.1.state": "completed",
    "receipts.2.request_id": "44444444-4444-4444-8444-000000000003",
    "receipts.2.state": "rejected",
    "receipts.2.detail": "control revoked"
   }
  },
  {
   "set_permissions": "c1",
   "permissions": [
    "view",
    "control"
   ],
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000005",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
     },
     "request_id": "44444444-4444-4444-8444-000000000003",
     "kind": "prompt",
     "payload": {
      "text": "then tag the release"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000003",
    "state": "rejected",
    "re": "11111111-1111-4111-8111-000000000005",
    "detail": "control revoked"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "dispatch_attempts": 2,
    "lease_holder": null
   }
  },
  {
   "restart_runtime": {
    "runtime_gen": "99999999-9999-4999-8999-999999999999",
    "runtime_epoch": 8
   }
  },
  {
   "reconnect": "c1",
   "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
  },
  {
   "reconnect": "c2",
   "attachment_gen": "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000006",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000003"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000006",
    "receipts.#": 1,
    "receipts.0.state": "rejected",
    "receipts.0.detail": "control revoked"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "dispatch_attempts": 2,
    "lease_holder": null
   }
  }
 ],
 "note": "Appendix §H. c1's principal sends P1 (acquiring) and queues P2. It disconnects and reconnects with the same permissions: same principal, same control_gen, so P2 still runs after P1 (disconnect and reconnect never cancel accepted work). After its lease expires, the new attachment sends P3, queued behind P2, then disconnects. The principal re-authenticates with view only while the old attachment is already gone: the host writes the fence first, revokes the lease that attachment held (revoked to c2), and rejects P3 (control revoked) although its attachment is gone; P2, executing, completes. Regaining control later gives no authority over P3: the duplicate returns the rejected receipt and nothing runs, also after a broker restart."
}

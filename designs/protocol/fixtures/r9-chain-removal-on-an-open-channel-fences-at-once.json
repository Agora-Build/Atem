{
  "name": "r9-chain-removal-on-an-open-channel-fences-at-once",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.3: a removal carried on an already open channel commits and fences the removed principal at once; no acknowledgement is needed.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ],
    "connected": [
      "phone"
    ],
    "holds_lease": {
      "svc": 1
    }
  },
  "steps": [
    {
      "send_membership": "phone",
      "entries": [
        "E7"
      ]
    },
    {
      "expect": "phone",
      "match": {
        "op": "membership_head",
        "head.seq": 7,
        "head.hash": "${hash:E7}"
      }
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "removed"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "lease_changed",
        "reason": "revoked"
      }
    },
    {
      "assert": {
        "head": "E7",
        "attachments": 1,
        "lease_holder": null
      }
    }
  ]
}

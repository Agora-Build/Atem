{
  "name": "r9-chain-honest-concurrent-appends-never-fork",
  "requires": "r9",
  "kind": "scenario",
  "side": "relay",
  "log": "r9-vectors-membership-log",
  "note": "R9.4: the relay's compare-and-swap makes the second honest append a 409; the loser discards its prepared entry (never carried), rebuilds on the new head with a fresh confirmation, and retries are idempotent (the same body re-signed has the same entry_hash). No host sees a fork.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ],
    "relay_head": "E5"
  },
  "steps": [
    {
      "relay_append": {
        "by": "dev-mac",
        "entry": "E6",
        "expected": "E5"
      },
      "status": 200
    },
    {
      "relay_append": {
        "by": "dev-phone",
        "entry": "S6_phone",
        "expected": "E5"
      },
      "status": 409,
      "reply": {
        "head": "E6",
        "entries": [
          "E6"
        ]
      }
    },
    {
      "assert_client": {
        "client": "phone",
        "discarded": [
          "S6_phone"
        ],
        "log_head": "E6"
      }
    },
    {
      "relay_append": {
        "by": "dev-phone",
        "entry": "E7",
        "expected": "E6"
      },
      "status": 200
    },
    {
      "relay_append": {
        "by": "dev-phone",
        "entry": "E7",
        "expected": "E6",
        "retry": true
      },
      "status": 200,
      "reply": {
        "stored": "E7"
      }
    },
    {
      "relay_append": {
        "by": "dev-phone",
        "entry": "E7_retry",
        "expected": "E6",
        "retry": true
      },
      "status": 200,
      "reply": {
        "stored": "E7"
      }
    },
    {
      "host_connect": {
        "client": "phone",
        "host_pinned": [
          "E1",
          "E2",
          "E3",
          "E4",
          "E5"
        ],
        "carry": [
          "E6",
          "E7"
        ]
      }
    },
    {
      "assert": {
        "head": "E7",
        "frozen": false,
        "carried_ever": {
          "S6_phone": false
        },
        "control_gen": {
          "service:svc-discord": 2
        }
      }
    }

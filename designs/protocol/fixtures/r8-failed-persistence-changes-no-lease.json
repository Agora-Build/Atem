{
 "name": "r8-failed-persistence-changes-no-lease",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "fail_next_fsync": true
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000001",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000001",
    "code": "busy"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 0
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000002",
    "capture": {
     "e1": "lease.lease_epoch"
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "granted",
    "lease_epoch": "${e1}"
   },
   "capture": {
    "c1ctl": "controller.controller_session"
   }
  },
  {
   "turn_complete": "ses-aaaaaaaaaaaa",
   "turn_id": "turn-1"
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "completed",
    "detail": "done"
   }
  },
  {
   "fail_next_fsync": true
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000002",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": "${e1}"
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000003",
    "code": "busy"
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c2",
   "for_ms": 0
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "renew",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": "${e1}"
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease",
    "re": "11111111-1111-4111-8111-000000000004",
    "binding.lease_epoch": "${e1}"
   }
  },
  {
   "assert": {
    "lease_holder": "c1",
    "dispatches": 1
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000005",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000002",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": "${e1}"
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000005",
    "capture": {
     "e2": "lease.lease_epoch"
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "executing"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": "${e2}"
   }
  },
  {
   "assert": {
    "lease_holder": "c2",
    "dispatches": 2
   }
  }
 ],
 "note": "The lease is committed only after the durable accepted write. When that write (or the epoch reservation before it) fails, the Send is answered busy: nothing recorded, no lease granted or taken over, nothing executed. The retry with the same request_id is a new admission. Epochs may skip after a failed reservation, so the fixture captures them."
}

{
 "name": "r8-history-page-and-live-events-share-one-ordered-stream",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "chat_history": "ses-aaaaaaaaaaaa",
   "messages": [
    {
     "messageId": "m-0001",
     "role": "user",
     "turnId": "turn-1",
     "createdAt": 1760600000000,
     "parts": [
      {
       "id": "p1",
       "kind": "text",
       "markdown": "run the tests"
      }
     ],
     "origin": "local"
    },
    {
     "messageId": "m-0002",
     "role": "assistant",
     "turnId": "turn-1",
     "createdAt": 1760600000000,
     "parts": [
      {
       "id": "p1",
       "kind": "text",
       "markdown": "Running npm test"
      }
     ]
    }
   ]
  },
  {
   "send": "c1",
   "json": {
    "type": "agentChat",
    "data": {
     "v": 1,
     "op": "open",
     "conversationId": "conv-1",
     "agentId": "ses-aaaaaaaaaaaa",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "opened",
    "sequence": 0
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 1,
    "messageId": "m-0001",
    "history": true
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 2,
    "messageId": "m-0002",
    "history": true
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "history_end",
    "sequence": 3,
    "page.end": true,
    "page.count": 2
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "turn_id": "turn-1"
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "tool": "Bash"
   },
   "capture": {
    "aid": "approval_id"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 4,
    "messageId": "approval-${aid}",
    "parts.0.state": "pending"
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "agentChat",
    "data": {
     "v": 1,
     "op": "history",
     "conversationId": "conv-1",
     "agentId": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "page_id": "p1",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "turn_id": "turn-1"
    }
   }
  },
  {
   "close_approval": "${aid}",
   "reason": "answered_terminal"
  },
  {
   "chat_message": "ses-aaaaaaaaaaaa",
   "message": {
    "messageId": "m-0002",
    "role": "assistant",
    "turnId": "turn-1",
    "createdAt": 1760600000000,
    "parts": [
     {
      "id": "p1",
      "kind": "text",
      "markdown": "Running npm test"
     },
     {
      "id": "p2",
      "kind": "text",
      "markdown": "All 12 tests passed."
     }
    ]
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 5,
    "messageId": "m-0001",
    "history": true,
    "page_id": "p1"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 6,
    "messageId": "m-0002",
    "history": true,
    "page_id": "p1",
    "parts.#": 1
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 7,
    "messageId": "approval-${aid}",
    "history": true,
    "page_id": "p1",
    "parts.0.state": "pending"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "history_end",
    "sequence": 8,
    "page_id": "p1",
    "page.end": true,
    "page.count": 3,
    "page.selector": "turn_id",
    "page.coverage": "complete"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "approval_closed",
    "approval_id": "${aid}",
    "reason": "answered_terminal"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 9,
    "messageId": "approval-${aid}",
    "parts.0.state": "answered_terminal",
    "parts.0.reason": "answered_terminal"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 10,
    "messageId": "m-0002",
    "parts.#": 2
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "agentChat",
    "data": {
     "v": 1,
     "op": "history",
     "conversationId": "conv-1",
     "agentId": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "page_id": "p2",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "turn_id": "turn-1"
    }
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 11,
    "messageId": "m-0001",
    "history": true,
    "page_id": "p2"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 12,
    "messageId": "m-0002",
    "history": true,
    "page_id": "p2",
    "parts.#": 2
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "message",
    "sequence": 13,
    "messageId": "approval-${aid}",
    "history": true,
    "page_id": "p2",
    "parts.0.state": "answered_terminal"
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "history_end",
    "sequence": 14,
    "page_id": "p2",
    "page.end": true,
    "page.count": 3
   }
  },
  {
   "assert": {
    "dispatch_attempts": 0,
    "pty_writes": 0,
    "lease_holder": null,
    "approvals_pending": 0
   }
  }
 ],
 "note": "A history page is snapshotted and enqueued in one host step, in the conversation's sequenced stream, between live events. The history request p1 arrives before the approval closes and m-0002 gains a part, so its page (sequences 5-8) holds the older versions and every newer version follows at a higher sequence (9, 10). A client keeps, per messageId, the version with the highest sequence: the delayed page never replaces the closed card or drop the appended part, and a page never revives an approval (the session inbox decides; approvals_pending is 0). A later page (p2) holds the new versions."
}
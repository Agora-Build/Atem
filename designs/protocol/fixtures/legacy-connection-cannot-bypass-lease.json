{
 "name": "legacy-connection-cannot-bypass-lease",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "up",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "upgraded": true,
    "client_kind": "native"
   },
   {
    "name": "legacy",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "upgraded": false,
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "up",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "acquire",
     "id": "11111111-1111-4111-8111-000000000001",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "takeover": false
    }
   }
  },
  {
   "expect": "up",
   "match": {
    "op": "lease",
    "re": "11111111-1111-4111-8111-000000000001"
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "agentInput",
    "data": {
     "agent_id": null,
     "kind": "text",
     "text": "rm -rf x"
    }
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "agentInput",
    "data": {
     "agent_id": null,
     "kind": "key",
     "key": "enter"
    }
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "voiceCommand",
    "data": {
     "text": "run the tests",
     "is_final": true
    }
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "userCommand",
    "data": {
     "command": "ls",
     "action": "cli_input"
    }
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "agentChat",
    "data": {
     "v": 1,
     "op": "submit",
     "conversationId": "c",
     "agentId": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "requestId": "44444444-4444-4444-8444-444444444445",
     "text": "hi"
    }
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "terminal",
    "data": {
     "v": 1,
     "op": "resize",
     "terminal_id": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "stream_id": "s",
     "lease_id": "l",
     "rows": 10,
     "cols": 10
    }
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "terminal",
    "data": {
     "v": 1,
     "op": "stop",
     "terminal_id": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "stream_id": "s",
     "lease_id": "l"
    }
   }
  },
  {
   "assert": {
    "pty_writes": 0,
    "resizes": 0,
    "stops": 0,
    "dispatches": 0,
    "lease_holder": "up"
   }
  },
  {
   "send": "legacy",
   "json": {
    "type": "terminal",
    "data": {
     "v": 1,
     "op": "control",
     "terminal_id": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "stream_id": "s",
     "take": true
    }
   }
  },
  {
   "expect": "up",
   "match": {
    "op": "lease_changed",
    "reason": "takeover"
   }
  },
  {
   "assert": {
    "lease_holder": "legacy"
   }
  },
  {
   "local_input": "ses-aaaaaaaaaaaa",
   "bytes": "eA=="
  },
  {
   "expect_all": {
    "op": "lease_changed",
    "reason": "local_input"
   }
  },
  {
   "assert": {
    "lease_holder": null,
    "pty_writes": 1
   }
  }
 ],
 "note": "terminal-v1 control on a legacy connection goes through the same authority (an explicit takeover); unscoped legacy mutations are refused while a remote holder exists. The terminal-v1 subscribe that precedes resize/stop/control on the legacy connection is elided; the host treats a missing subscription as forbidden either way."
}
{
 "name": "r8-revoked-control-refuses-the-send-and-its-queued-prompt",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000001",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000001",
    "lease.lease_epoch": 1
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "granted",
    "lease_epoch": 1
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "request_id": "44444444-4444-4444-8444-000000000002",
     "kind": "prompt",
     "payload": {
      "text": "then deploy"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000002",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000002",
    "lease.lease_epoch": 1
   }
  },
  {
   "set_permissions": "c1",
   "permissions": [
    "view"
   ],
   "attachment_gen": "99999999-9999-4999-8999-999999999999"
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "revoked",
    "lease_epoch": 2,
    "controller": null
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "99999999-9999-4999-8999-999999999999"
     },
     "request_id": "44444444-4444-4444-8444-000000000003",
     "kind": "prompt",
     "payload": {
      "text": "deploy anyway"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000003",
    "code": "forbidden"
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "99999999-9999-4999-8999-999999999999"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000001",
      "44444444-4444-4444-8444-000000000002",
      "44444444-4444-4444-8444-000000000003"
     ]
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000004",
    "receipts.#": 2,
    "receipts.0.request_id": "44444444-4444-4444-8444-000000000001",
    "receipts.0.state": "executing",
    "receipts.1.request_id": "44444444-4444-4444-8444-000000000002",
    "receipts.1.state": "rejected",
    "receipts.1.detail": "control revoked"
   }
  },
  {
   "turn_complete": "ses-aaaaaaaaaaaa",
   "turn_id": "turn-1"
  },
  {
   "assert": {
    "lease_holder": null,
    "dispatch_attempts": 1,
    "dispatches": 1
   }
  }
 ],
 "note": "c1's device loses control (re-authenticated with view only: a new attachment, the old one fenced). The host revokes the lease that attachment held (revoked), rejects its accepted prompts not yet executing (detail control revoked), and lets executing work finish (§6). Its later Send is forbidden before any lease check: control authorizes, the lease only coordinates writers."
}

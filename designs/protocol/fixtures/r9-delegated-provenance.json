{
  "name": "r9-delegated-provenance",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "session-v1 R9.14 items 1 and 2. The host-work principal submits its attempt on its internal attachment, acquiring the lease as any controller would: a native viewer sees `lease_changed{granted}` and its own acquiring Send is `lease_held`. The attempt's receipt carries `task_id` and `sender`, for a native's `receipt_query` too, through its turn's end. At the turn's end the runtime releases the lease, and the native's own prompt runs (its receipt carries neither field: host_work_tests::other_receipts_carry_no_provenance). The fake agent takes each pasted prompt as turn `turn-<n>`.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      }
    ],
    "connected": [
      "mac"
    ]
  },
  "steps": [
    {
      "host_work_submit": "ses-aaaaaaaaaaaa",
      "request_id": "cccccccc-0000-4000-8000-000000000101",
      "task_id": "dddddddd-0000-4000-8000-000000000101",
      "sender": "member:dev-phone",
      "text": "run the tests",
      "result": {
        "state": "executing"
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "lease_changed",
        "reason": "granted"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000101",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "cccccccc-0000-4000-8000-000000000102",
          "payload": {
            "text": "also lint"
          },
          "acquire": true
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "error",
        "code": "lease_held"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "receipt_query",
          "id": "aaaaaaaa-0000-4000-8000-000000000102",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "request_ids": [
            "cccccccc-0000-4000-8000-000000000101"
          ]
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipts",
        "receipts.#": 1,
        "receipts.0.request_id": "cccccccc-0000-4000-8000-000000000101",
        "receipts.0.state": "executing",
        "receipts.0.task_id": "dddddddd-0000-4000-8000-000000000101",
        "receipts.0.sender": "member:dev-phone"
      }
    },
    {
      "turn_complete": "ses-aaaaaaaaaaaa",
      "turn_id": "turn-1"
    },
    {
      "expect": "mac",
      "match": {
        "op": "lease_changed",
        "reason": "released"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "receipt_query",
          "id": "aaaaaaaa-0000-4000-8000-000000000103",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "request_ids": [
            "cccccccc-0000-4000-8000-000000000101"
          ]
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipts",
        "receipts.0.state": "completed",
        "receipts.0.detail": "done",
        "receipts.0.task_id": "dddddddd-0000-4000-8000-000000000101",
        "receipts.0.sender": "member:dev-phone"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000104",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "cccccccc-0000-4000-8000-000000000103",
          "payload": {
            "text": "also lint"
          },
          "acquire": true
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipt",
        "state": "accepted",
        "request_id": "cccccccc-0000-4000-8000-000000000103"
      }
    },
    {
      "assert": {
        "receipts": {
          "cccccccc-0000-4000-8000-000000000101": {
            "state": "completed",
            "detail": "done"
          },
          "cccccccc-0000-4000-8000-000000000103": {
            "state": "executing",
            "detail": null
          }
        },
        "dispatches": 2
      }
    }
  ]
}

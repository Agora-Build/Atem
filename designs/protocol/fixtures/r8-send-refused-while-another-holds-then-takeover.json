{
 "name": "r8-send-refused-while-another-holds-then-takeover",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1,
    "sessions.0.controller.lease_epoch": 1
   },
   "capture": {
    "c1ctl": "sessions.0.controller.controller_session"
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000002",
    "code": "lease_held",
    "controller.controller_session": "${c1ctl}",
    "controller.lease_epoch": 1
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "assert": {
    "lease_holder": "c1",
    "dispatch_attempts": 0
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000003",
    "lease.lease_epoch": 2,
    "lease.ms_left": 15000
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 2
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 2
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "renew",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000004",
    "code": "stale_lease"
   }
  },
  {
   "assert": {
    "lease_holder": "c2",
    "dispatches": 1
   }
  }
 ],
 "note": "Another attachment holds the lease. An ordinary Send (acquire without takeover) is refused lease_held naming the holder (controller{controller_session, lease_epoch}, the descriptor's shape): nothing is recorded, nothing executes, no takeover. The confirmed retry keeps the same request_id and text and adds takeover: true with expected_controller exactly as the dialog showed; the host takes over and accepts in one operation, the old holder gets lease_changed{takeover} and its epoch is stale."
}

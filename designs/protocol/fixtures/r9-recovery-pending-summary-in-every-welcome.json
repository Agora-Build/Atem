{
  "name": "r9-recovery-pending-summary-in-every-welcome",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.5, R9.8: every welcome lists the pending entries (hash, subject, effective_at on the host clock), so a device that never got the entry or any push learns of it from any host; attachments get it in membership_head when it changes, and the host shows it locally.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793177601000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ]
  },
  "steps": [
    {
      "connect": "phone",
      "carry": [
        "R7"
      ]
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7}",
        "pending_recovery": [
          {
            "entry_hash": "${hash:R7}",
            "seq": 7,
            "action": "recovery_add",
            "subject": "dev-newmac",
            "effective_at": 1793264001000
          }
        ]
      }
    },
    {
      "advance_ms": 600000
    },
    {
      "connect": "mac",
      "carry": [],
      "client_head": "E6"
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-mac",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 7,
        "head.hash": "${hash:R7}",
        "pending_recovery": [
          {
            "entry_hash": "${hash:R7}",
            "seq": 7,
            "action": "recovery_add",
            "subject": "dev-newmac",
            "effective_at": 1793264001000
          }
        ]
      }
    },
    {
      "expect_local_status": {
        "recovery_pending": true
      }
    },
    {
      "advance_ms": 85800000
    },
    {
      "expect": "mac",
      "match": {
        "op": "membership_head",
        "head.seq": 7,
        "head.hash": "${hash:R7}",
        "pending_recovery": []
      }
    }
  ]
}

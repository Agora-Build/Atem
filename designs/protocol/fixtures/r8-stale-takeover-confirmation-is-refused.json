{
 "name": "r8-stale-takeover-confirmation-is-refused",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   },
   {
    "name": "c3",
    "attachment_gen": "77777777-7777-4777-8777-777777777777",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1,
    "sessions.0.controller.lease_epoch": 1
   },
   "capture": {
    "c1ctl": "sessions.0.controller.controller_session"
   }
  },
  {
   "send": "c3",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000002"
    }
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000002",
    "sessions.#": 1,
    "sessions.0.controller.lease_epoch": 1
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000003",
    "code": "lease_held",
    "controller.controller_session": "${c1ctl}",
    "controller.lease_epoch": 1
   }
  },
  {
   "send": "c3",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "acquire",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "77777777-7777-4777-8777-777777777777"
     },
     "takeover": true
    }
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "lease",
    "re": "11111111-1111-4111-8111-000000000004",
    "binding.lease_epoch": 2
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 2
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 2
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 2
   },
   "capture": {
    "c3ctl": "controller.controller_session"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 2
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000005",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c1ctl}",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000005",
    "code": "lease_held",
    "controller.controller_session": "${c3ctl}",
    "controller.lease_epoch": 2
   }
  },
  {
   "expect_none": "c1",
   "for_ms": 0
  },
  {
   "expect_none": "c3",
   "for_ms": 0
  },
  {
   "assert": {
    "lease_holder": "c3",
    "dispatch_attempts": 0
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000006",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true,
     "takeover": true,
     "expected_controller": {
      "controller_session": "${c3ctl}",
      "lease_epoch": 2
     }
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000006",
    "lease.lease_epoch": 3
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 3
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 3
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 3
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 3
   }
  },
  {
   "send": "c3",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "renew",
     "id": "11111111-1111-4111-8111-000000000007",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "77777777-7777-4777-8777-777777777777",
      "lease_epoch": 2
     }
    }
   }
  },
  {
   "expect": "c3",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000007",
    "code": "stale_lease"
   }
  },
  {
   "assert": {
    "lease_holder": "c2",
    "dispatches": 1
   }
  }
 ],
 "note": "A takeover confirmation authorizes taking over exactly the lease it showed. c2's dialog named c1's lease (epoch 1); meanwhile c3 took over (epoch 2). c2's takeover Send names a lease that no longer exists: refused lease_held with the current holder, nothing recorded or executed, c3 keeps control. Re-confirmed against c3's lease it takes over and accepts atomically."
}

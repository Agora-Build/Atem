{
 "name": "closed-session-refuses-work-before-the-lease-check",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native",
    "holds_lease_epoch": 1
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "terminal",
    "data": {
     "v": 1,
     "op": "subscribe",
     "terminal_id": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "terminal",
   "match": {
    "op": "attached",
    "session.terminal_id": "ses-aaaaaaaaaaaa"
   },
   "capture": {
    "s": "stream_id"
   }
  },
  {
   "close_session": "ses-aaaaaaaaaaaa"
  },
  {
   "expect": "c1",
   "match": {
    "op": "lease_changed",
    "reason": "revoked",
    "lease_epoch": 2,
    "controller": null
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000001",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000001",
    "code": "session_closed"
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "terminal",
    "data": {
     "v": 1,
     "op": "input",
     "terminal_id": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "stream_id": "${s}",
     "sequence": 0,
     "bytes": "aGkN",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "terminal",
   "match": {
    "op": "error",
    "code": "session_closed",
    "terminal_id": "ses-aaaaaaaaaaaa",
    "stream_id": "${s}"
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "agentChat",
    "data": {
     "v": 1,
     "op": "submit",
     "conversationId": "conv-1",
     "agentId": "ses-aaaaaaaaaaaa",
     "generation": "22222222-2222-4222-8222-222222222222",
     "requestId": "44444444-4444-4444-8444-000000000002",
     "text": "run the tests",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c1",
   "type": "agentChat",
   "match": {
    "op": "error",
    "code": "session_closed",
    "requestId": "44444444-4444-4444-8444-000000000002"
   }
  },
  {
   "assert": {
    "pty_writes": 0,
    "dispatch_attempts": 0,
    "stops": 0
   }
  }
 ],
 "note": "Closing a session revokes its lease; later work is session_closed (checked before the lease) in each family, with no effect."
}
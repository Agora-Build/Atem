{
  "name": "r9-envelope-several-channels",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.7a: three clients share Atem's one link through three handles; each is its own channel and attachment. The router closing one channel fences only its attachment; a failed record on another closes only that channel; the remaining client keeps working. Inits are spaced 1 s apart (one init a second per link).",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ]
  },
  "steps": [
    {
      "link_up": true
    },
    {
      "connect": "phone",
      "channel": "ch-phone",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "principal": "member:dev-phone",
        "client_kind": "native"
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "connect": "mac",
      "channel": "ch-mac",
      "transport": "direct",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "principal": "member:dev-mac"
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "connect": "svc",
      "channel": "ch-svc",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "welcome",
        "principal": "service:svc-discord",
        "client_kind": "service"
      }
    },
    {
      "assert": {
        "channels": 3,
        "attachments": 3
      }
    },
    {
      "close_channel": "ch-mac",
      "reason": "client_gone"
    },
    {
      "expect_no_envelope": {
        "channel": "ch-mac",
        "for_ms": 100
      }
    },
    {
      "assert": {
        "channels": 2,
        "attachments": 2
      }
    },
    {
      "send_record": "svc",
      "tamper": "tag"
    },
    {
      "expect_envelope": {
        "match": {
          "event": "close",
          "channel": "ch-svc",
          "reason": "closed"
        }
      }
    },
    {
      "assert": {
        "channels": 1,
        "attachments": 1
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "list",
          "id": "aaaaaaaa-0000-4000-8000-000000000101"
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "sessions",
        "sessions.#": 1
      }
    }
  ]
}

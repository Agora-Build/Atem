{
 "name": "reconnect-restarts-the-registry-sequence",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222"
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "seq": 1,
    "runtime_epoch": 7,
    "sessions.#": 1
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "acquire",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "takeover": false
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease",
    "re": "11111111-1111-4111-8111-000000000002"
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "session_changed",
    "seq": 2,
    "descriptor.controller.lease_epoch": 1
   }
  },
  {
   "reconnect": "c1",
   "attachment_gen": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000003"
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000003",
    "seq": 1,
    "runtime_epoch": 7,
    "sessions.0.controller.lease_epoch": 1
   }
  },
  {
   "local_input": "ses-aaaaaaaaaaaa",
   "bytes": "eA=="
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "local_input",
    "lease_epoch": 2
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "session_changed",
    "seq": 2,
    "descriptor.controller": null
   }
  }
 ],
 "note": "seq counts the messages one attachment received: a reconnected client (new attachment) gets a snapshot at seq 1 again and changes continue from there; the old attachment's lease is not inherited."
}
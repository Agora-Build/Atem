{
 "name": "approval-answer-with-acquire-takes-control-from-the-holder",
 "setup": {
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222"
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "holds_lease_epoch": 1,
    "client_kind": "native"
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ],
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  }
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000002"
    }
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000002",
    "sessions.#": 1
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    },
    {
     "rule_id": "r-npm",
     "label": "Bash(npm:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     },
     {
      "rule_id": "r-npm",
      "label": "Bash(npm:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "aid": "approval_id"
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     },
     {
      "rule_id": "r-npm",
      "label": "Bash(npm:*)",
      "scope": "this project"
     }
    ],
    "approval_id": "${aid}"
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "approval",
     "payload": {
      "approval_id": "${aid}",
      "decision": "deny",
      "message": "use the staging config",
      "acquire": true
     }
    }
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 2
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 2
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "kind": "approval",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000003"
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "kind": "approval",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "match": {
    "op": "approval_closed",
    "approval_id": "${aid}",
    "reason": "answered_remote"
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "lease_changed",
    "reason": "takeover",
    "lease_epoch": 2
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "session_changed",
    "descriptor.controller.lease_epoch": 2
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_closed",
    "approval_id": "${aid}",
    "reason": "answered_remote"
   }
  },
  {
   "assert": {
    "approval_decisions": [
     {
      "approval_id": "${aid}",
      "decision": "deny",
      "message": "use the staging config"
     }
    ],
    "lease_holder": "c2",
    "receipts_visible": {
     "c1": 1,
     "c2": 1
    }
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "renew",
     "id": "11111111-1111-4111-8111-000000000004",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     }
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000004",
    "code": "stale_lease"
   }
  }
 ],
 "note": "A device that is not the lease holder (e.g. a phone woken by the push) answers with acquire: true: the host takes the lease for it (takeover) and hands the decision over atomically; the old holder sees the takeover and its epoch is stale."
}

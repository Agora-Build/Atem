{
  "name": "r9-service-scope-and-expiry",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.6: a service sees only in-scope sessions (another project is unknown_session), may prompt but not type (no terminal op), gets no approval cards without the approval op, and is fenced at expiry by the timer and refused at admission afterwards.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      },
      {
        "session_id": "ses-bbbbbbbbbbbb",
        "process_gen": "33333333-3333-4333-8333-333333333333",
        "chat": true,
        "project": "h1.b982533d.cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"
      }
    ],
    "clients": [
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ],
    "connected": [
      "phone"
    ]
  },
  "steps": [
    {
      "connect": "svc",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "service",
        "principal": "service:svc-discord",
        "permissions": [
          "control",
          "view"
        ],
        "scope.ops": [
          "interrupt",
          "prompt",
          "view"
        ],
        "authorization_ms_left": 86400000
      }
    },
    {
      "send": "svc",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "list",
          "id": "aaaaaaaa-0000-4000-8000-000000000010"
        }
      }
    },
    {
      "expect": "svc",
      "match": {
        "op": "sessions",
        "sessions.#": 1,
        "sessions.0.session_id": "ses-aaaaaaaaaaaa"
      }
    },
    {
      "send": "svc",
      "json": {
        "type": "agentChat",
        "data": {
          "v": 1,
          "op": "open",
          "conversationId": "cccccccc-0000-4000-8000-000000000001",
          "agentId": "ses-bbbbbbbbbbbb",
          "binding": "${binding:svc:ses-bbbbbbbbbbbb}"
        }
      }
    },
    {
      "expect": "svc",
      "type": "agentChat",
      "match": {
        "op": "error",
        "code": "unknown_session"
      }
    },
    {
      "send": "svc",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000011",
          "binding": "${binding:svc:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000011",
          "acquire": true,
          "payload": {
            "text": "status?"
          }
        }
      }
    },
    {
      "expect": "svc",
      "match": {
        "op": "receipt",
        "state": "accepted",
        "lease.lease_epoch": 1
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "lease_changed",
        "reason": "granted",
        "lease_epoch": 1
      }
    },
    {
      "send": "svc",
      "json": {
        "type": "terminal",
        "data": {
          "v": 1,
          "op": "input",
          "terminal_id": "ses-aaaaaaaaaaaa",
          "generation": "22222222-2222-4222-8222-222222222222",
          "stream_id": "dddddddd-0000-4000-8000-000000000001",
          "sequence": 0,
          "bytes": "eA==",
          "binding": "${lease_binding:svc:ses-aaaaaaaaaaaa}"
        }
      }
    },
    {
      "expect": "svc",
      "type": "terminal",
      "match": {
        "op": "error",
        "code": "forbidden"
      }
    },
    {
      "open_approval": "ses-aaaaaaaaaaaa",
      "tool": "Bash",
      "summary": "npm test"
    },
    {
      "expect": "phone",
      "match": {
        "op": "approval_request"
      },
      "capture": {
        "ap": "approval.approval_id"
      }
    },
    {
      "expect_none": "svc",
      "for_ms": 0
    },
    {
      "set_wall_clock": 1794992004000
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "expired"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "lease_changed",
        "reason": "revoked"
      }
    },
    {
      "assert": {
        "control_gen": {
          "service:svc-discord": 2
        },
        "attachments": 1
      }
    },
    {
      "connect": "svc",
      "carry": []
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "unauthorized",
        "detail": "expired"
      }
    }
  ]
}

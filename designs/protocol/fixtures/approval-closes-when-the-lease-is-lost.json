{
 "name": "approval-closes-when-the-lease-is-lost",
 "setup": {
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222"
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "holds_lease_epoch": 1,
    "client_kind": "native"
   }
  ],
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  }
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "list",
     "id": "11111111-1111-4111-8111-000000000001"
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "sessions",
    "re": "11111111-1111-4111-8111-000000000001",
    "sessions.#": 1
   }
  },
  {
   "open_approval": "ses-aaaaaaaaaaaa",
   "tool": "Bash",
   "summary": "npm test",
   "always_rules": [
    {
     "rule_id": "r-npm-test",
     "label": "Bash(npm test:*)",
     "scope": "this project"
    },
    {
     "rule_id": "r-npm",
     "label": "Bash(npm:*)",
     "scope": "this project"
    }
   ]
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_request",
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "tool": "Bash",
    "summary": "npm test",
    "always_rules": [
     {
      "rule_id": "r-npm-test",
      "label": "Bash(npm test:*)",
      "scope": "this project"
     },
     {
      "rule_id": "r-npm",
      "label": "Bash(npm:*)",
      "scope": "this project"
     }
    ]
   },
   "capture": {
    "aid": "approval_id"
   }
  },
  {
   "advance_ms": 15000
  },
  {
   "expect": "c1",
   "match": {
    "op": "lease_changed",
    "reason": "expired",
    "lease_epoch": 2,
    "controller": null
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "session_changed",
    "descriptor.controller": null
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "approval_closed",
    "approval_id": "${aid}",
    "reason": "lease_lost"
   }
  },
  {
   "assert": {
    "approvals_pending": 0,
    "approvals_released": 1
   }
  },
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333",
      "lease_epoch": 1
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "approval",
     "payload": {
      "approval_id": "${aid}",
      "decision": "allow_once"
     }
    }
   }
  },
  {
   "expect": "c1",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000002",
    "code": "stale_lease"
   }
  },
  {
   "assert": {
    "approval_decisions": [],
    "dispatches": 0,
    "lease_holder": null
   }
  }
 ],
 "note": "An approval is answerable only by the lease holder: when the lease ends (here: expiry at the deadline) the pending approval closes lease_lost for viewers and the runtime is told to answer the agent 'no decision' (its own prompt asks); a late answer is refused."
}

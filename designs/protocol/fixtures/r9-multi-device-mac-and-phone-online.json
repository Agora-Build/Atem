{
  "name": "r9-multi-device-mac-and-phone-online",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.10: the Mac and the phone are separate principals on separate channels; r8 §F decides the lease (the phone's Send is lease_held, nothing runs) and receipts stay with their submitter.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ]
  },
  "steps": [
    {
      "connect": "mac",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-mac",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 6,
        "head.hash": "${hash:E6}"
      }
    },
    {
      "connect": "phone",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 6,
        "head.hash": "${hash:E6}"
      }
    },
    {
      "send": "mac",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000040",
          "binding": "${binding:mac:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000040",
          "acquire": true,
          "payload": {
            "text": "run the tests"
          }
        }
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipt",
        "state": "accepted",
        "lease.lease_epoch": 1
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "lease_changed",
        "reason": "granted",
        "controller.lease_epoch": 1
      }
    },
    {
      "send": "phone",
      "json": {
        "type": "session",
        "data": {
          "v": 1,
          "op": "submit",
          "id": "aaaaaaaa-0000-4000-8000-000000000041",
          "binding": "${binding:phone:ses-aaaaaaaaaaaa}",
          "kind": "prompt",
          "request_id": "bbbbbbbb-0000-4000-8000-000000000041",
          "acquire": true,
          "payload": {
            "text": "also lint"
          }
        }
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "error",
        "code": "lease_held",
        "controller.lease_epoch": 1
      }
    },
    {
      "turn_complete": "ses-aaaaaaaaaaaa",
      "turn_id": "t1"
    },
    {
      "expect": "mac",
      "match": {
        "op": "receipt",
        "state": "completed"
      }
    },
    {
      "assert": {
        "lease_holder": "mac",
        "dispatches": 1,
        "receipts_visible": {
          "mac": 1,
          "phone": 1
        }
      }
    }
  ]
}

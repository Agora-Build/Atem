{
  "name": "r9-chain-relay-cas-failure-freezes-both-hosts",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.4: if the relay's CAS fails and accepts E6 and S6_phone (both honest, both signed by current managers), the hosts first apply different successors and each freezes when the other branch arrives; nothing is merged. Host B's add_host is outside the vectors: this checks chain handling only (handshake keys come from the harness).",
  "setup": {
    "hosts": [
      {
        "account_id": "acct-test-1",
        "atem_device_id": "host-a",
        "host_id": "host-a",
        "host_trust_gen": 1,
        "runtime_gen": "11111111-1111-4111-8111-111111111111",
        "runtime_epoch": 1,
        "wall_clock_ms": 1793264000000,
        "name": "A"
      },
      {
        "account_id": "acct-test-1",
        "atem_device_id": "host-b",
        "host_id": "host-b",
        "host_trust_gen": 1,
        "runtime_gen": "11111111-1111-4111-8111-111111111111",
        "runtime_epoch": 1,
        "wall_clock_ms": 1793264000000,
        "name": "B"
      }
    ],
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      }
    ]
  },
  "steps": [
    {
      "connect": "mac",
      "host": "A",
      "carry": [
        "E6"
      ]
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-mac",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 6,
        "head.hash": "${hash:E6}"
      }
    },
    {
      "connect": "phone",
      "host": "B",
      "carry": [
        "S6_phone"
      ]
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome",
        "revision": 9,
        "client_kind": "native",
        "principal": "member:dev-phone",
        "permissions": [
          "control",
          "view"
        ],
        "head.seq": 6,
        "head.hash": "${hash:S6_phone}"
      }
    },
    {
      "connect": "phone",
      "host": "A",
      "client_head": "S6_phone",
      "carry": [
        "S6_phone"
      ],
      "window": true
    },
    {
      "expect": "phone",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "connect": "mac",
      "host": "B",
      "client_head": "E6",
      "carry": [
        "E6"
      ],
      "window": true
    },
    {
      "expect": "mac",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "assert": {
        "host": "A",
        "frozen": true
      }
    },
    {
      "assert": {
        "host": "B",
        "frozen": true
      }
    }
  ]
}

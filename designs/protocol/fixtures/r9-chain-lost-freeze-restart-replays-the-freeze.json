{
  "name": "r9-chain-lost-freeze-restart-replays-the-freeze",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.3, R9.4 (Astation r4 review 2): a conflicting window (C6_mac) is carried; its carriage record is durable, then the freeze file write fails and is lost entirely. Atem is frozen in memory and halts. At restart no freeze file exists and nobody carries the conflict again, but the carriage record is replayed and the conflict freezes the host again, durably this time. A restart is never an unfreeze path.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ],
    "connected": [
      "phone"
    ],
    "holds_lease": {
      "mac": 1
    }
  },
  "steps": [
    {
      "fail_next_membership_write": {
        "at": "temp_write",
        "file": "freeze"
      }
    },
    {
      "connect": "svc",
      "carry": [
        "C6_mac"
      ],
      "window": true
    },
    {
      "expect": "svc",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "expect": "mac",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "expect": "phone",
      "match": {
        "op": "error",
        "code": "account_frozen"
      }
    },
    {
      "assert": {
        "frozen": true,
        "frozen_durable": false,
        "membership_halted": true,
        "carriage_record": true,
        "attachments": 0,
        "lease_holder": null
      }
    },
    {
      "local_input": "ses-aaaaaaaaaaaa",
      "bytes": "bHMNCg=="
    },
    {
      "assert": {
        "pty_writes_local": 1,
        "pty_writes_remote": 0
      }
    },
    {
      "restart_runtime": {
        "runtime_gen": "44444444-4444-4444-8444-444444444444",
        "runtime_epoch": 2
      },
      "disk": "write_lost"
    },
    {
      "assert": {
        "frozen": true,
        "frozen_durable": true,
        "head": "E6",
        "carriage_record": false
      }
    },
    {
      "connect": "phone",
      "carry": [],
      "client_head": "E6"
    },
    {
      "expect_channel_error": "phone",
      "code": "account_frozen",
      "at": "init"
    },
    {
      "advance_ms": 86400000
    },
    {
      "restart_runtime": {
        "runtime_gen": "55555555-5555-4555-8555-555555555555",
        "runtime_epoch": 3
      }
    },
    {
      "assert": {
        "frozen": true
      }
    }
  ]
}

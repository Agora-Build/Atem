{
  "name": "r9-envelope-bounds",
  "requires": "r9",
  "kind": "scenario",
  "side": "host",
  "log": "r9-vectors-membership-log",
  "note": "R9.7a bounds: the largest legal record (1 MiB of plaintext, a 1 398 279-byte envelope with a 64-character handle) passes; one plaintext byte more is refused by the sender, and a peer that sends it anyway (a 1 398 160-byte `rec` whose `ct` is over the bound) gets close{too_large} for its channel only; an envelope over 2 MiB closes its channel (too_large); a second init within a second on the link is busy; a channel whose queued output passes 4 MiB is closed (busy) while another channel stays.",
  "setup": {
    "host": {
      "account_id": "acct-test-1",
      "atem_device_id": "host-a",
      "host_id": "host-a",
      "host_trust_gen": 1,
      "runtime_gen": "11111111-1111-4111-8111-111111111111",
      "runtime_epoch": 1,
      "wall_clock_ms": 1793264000000
    },
    "pinned": [
      "E1",
      "E2",
      "E3",
      "E4",
      "E5",
      "E6"
    ],
    "sessions": [
      {
        "session_id": "ses-aaaaaaaaaaaa",
        "process_gen": "22222222-2222-4222-8222-222222222222",
        "chat": true,
        "project": "h1.b982533d.abababababababababababababababababababababababababababababababab"
      }
    ],
    "clients": [
      {
        "name": "phone",
        "principal": "member:dev-phone",
        "key": "dev-phone"
      },
      {
        "name": "mac",
        "principal": "member:dev-mac",
        "key": "dev-mac"
      },
      {
        "name": "svc",
        "principal": "service:svc-discord",
        "key": "svc-discord"
      }
    ]
  },
  "steps": [
    {
      "link_up": true
    },
    {
      "connect": "phone",
      "channel": "hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome"
      }
    },
    {
      "send_frame": "phone",
      "frame_of_plaintext_bytes": 1048576,
      "expect_envelope_bytes": 1398279
    },
    {
      "expect_channel_open": "phone"
    },
    {
      "connect": "mac",
      "channel": "ch-mac",
      "transport": "direct",
      "carry": [],
      "expect_init_refused": "busy"
    },
    {
      "expect_envelope": {
        "match": {
          "event": "close",
          "channel": "ch-mac",
          "reason": "busy"
        }
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "connect": "mac",
      "channel": "ch-mac-2",
      "transport": "direct",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome"
      }
    },
    {
      "envelope_in_bytes": {
        "channel": "ch-mac-2",
        "bytes": 2097153
      }
    },
    {
      "expect_envelope": {
        "match": {
          "event": "close",
          "channel": "ch-mac-2",
          "reason": "too_large"
        }
      }
    },
    {
      "send_frame": "phone",
      "frame_of_plaintext_bytes": 1048577,
      "unchecked": true
    },
    {
      "expect_envelope": {
        "match": {
          "event": "close",
          "channel": "hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh",
          "reason": "too_large"
        }
      }
    },
    {
      "assert": {
        "channels": 0,
        "attachments": 0
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "connect": "phone",
      "channel": "ch-phone-2",
      "transport": "relay",
      "carry": []
    },
    {
      "expect": "phone",
      "match": {
        "op": "welcome"
      }
    },
    {
      "advance_ms": 1000
    },
    {
      "connect": "mac",
      "channel": "ch-mac-3",
      "transport": "direct",
      "carry": []
    },
    {
      "expect": "mac",
      "match": {
        "op": "welcome"
      }
    },
    {
      "stall_link": true
    },

{
 "name": "r8-two-simultaneous-sends-acquire-once",
 "requires": "r8",
 "setup": {
  "host": {
   "account_id": "account-a",
   "atem_device_id": "host-a",
   "host_trust_gen": 1,
   "runtime_gen": "55555555-5555-4555-8555-555555555555",
   "runtime_epoch": 7
  },
  "sessions": [
   {
    "session_id": "ses-aaaaaaaaaaaa",
    "process_gen": "22222222-2222-4222-8222-222222222222",
    "chat": true
   }
  ],
  "clients": [
   {
    "name": "c1",
    "attachment_gen": "33333333-3333-4333-8333-333333333333",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   },
   {
    "name": "c2",
    "attachment_gen": "66666666-6666-4666-8666-666666666666",
    "permissions": [
     "view",
     "control"
    ],
    "client_kind": "native"
   }
  ]
 },
 "steps": [
  {
   "send": "c1",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000001",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "33333333-3333-4333-8333-333333333333"
     },
     "request_id": "44444444-4444-4444-8444-000000000001",
     "kind": "prompt",
     "payload": {
      "text": "run the tests"
     },
     "acquire": true
    }
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "submit",
     "id": "11111111-1111-4111-8111-000000000002",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_id": "44444444-4444-4444-8444-000000000002",
     "kind": "prompt",
     "payload": {
      "text": "deploy to staging"
     },
     "acquire": true
    }
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "accepted",
    "re": "11111111-1111-4111-8111-000000000001",
    "lease.lease_epoch": 1
   }
  },
  {
   "expect": "c1",
   "type": "session",
   "match": {
    "op": "receipt",
    "request_id": "44444444-4444-4444-8444-000000000001",
    "state": "executing"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "lease_changed",
    "reason": "granted",
    "lease_epoch": 1
   },
   "capture": {
    "c1ctl": "controller.controller_session"
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "error",
    "re": "11111111-1111-4111-8111-000000000002",
    "code": "lease_held",
    "controller.controller_session": "${c1ctl}",
    "controller.lease_epoch": 1
   }
  },
  {
   "send": "c2",
   "json": {
    "type": "session",
    "data": {
     "v": 1,
     "op": "receipt_query",
     "id": "11111111-1111-4111-8111-000000000003",
     "binding": {
      "target": {
       "account_id": "account-a",
       "atem_device_id": "host-a",
       "host_trust_gen": 1,
       "session_id": "ses-aaaaaaaaaaaa",
       "process_gen": "22222222-2222-4222-8222-222222222222"
      },
      "attachment_gen": "66666666-6666-4666-8666-666666666666"
     },
     "request_ids": [
      "44444444-4444-4444-8444-000000000002"
     ]
    }
   }
  },
  {
   "expect": "c2",
   "type": "session",
   "match": {
    "op": "receipts",
    "re": "11111111-1111-4111-8111-000000000003",
    "receipts.#": 0
   }
  },
  {
   "assert": {
    "lease_holder": "c1",
    "dispatch_attempts": 1,
    "dispatches": 1
   }
  }
 ],
 "note": "Two ordinary Sends from different attachments reach an unowned session at the same instant. Admission is one step of the broker's single-threaded pass: the first admitted acquires and is accepted; the second sees the new holder and is refused lease_held with nothing recorded or executed."
}
